# Groq (OpenAI-compatible). Get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Inventory is always loaded from the Pagume API (database). Start ../api first.
INVENTORY_CLIENT=http
PAGUME_API_BASE_URL=http://127.0.0.1:8000

# false = deterministic supervisor pipeline (no LLM required)
USE_LLM=true

HOST=0.0.0.0
PORT=8100
