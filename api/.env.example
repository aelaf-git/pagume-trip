# Local PostgreSQL (install Postgres on the machine; do not use Docker).
# Create DB:  sudo -u postgres psql -c "CREATE USER pagume WITH PASSWORD 'pagume';"
#             sudo -u postgres psql -c "CREATE DATABASE pagume OWNER pagume;"
DATABASE_URL=postgresql+psycopg://pagume:pagume@localhost:5432/pagume
HOST=0.0.0.0
PORT=8000
SEED_ON_STARTUP=true
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
