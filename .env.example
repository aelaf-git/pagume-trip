# Pagume Trip — copy to `.env` and fill in real values.
# Used by Docker Compose (repo root) and as the demo template for local runs.
#
# Local API:    copy DATABASE_URL / CLOUDINARY_URL into api/.env
# Local agents: copy GROQ_* / USE_LLM / LLM_* into agents/.env

# --- Primary database (Neon) -------------------------------------------------
# Compose accepts either name; NEON_DATABASE_URL wins if both are set.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/DBNAME?sslmode=require
NEON_DATABASE_URL=

# --- Local mirror (PostGIS container) ----------------------------------------
POSTGRES_USER=pagume
POSTGRES_PASSWORD=pagume
POSTGRES_DB=pagume
LOCAL_DATABASE_URL=postgresql+psycopg://pagume:pagume@db:5432/pagume

# --- Failover ----------------------------------------------------------------
DB_FAILOVER_ENABLED=true
DB_CONNECT_TIMEOUT=3
DB_PROBE_INTERVAL=30
DB_SYNC_AUTO_PUSH=true
SEED_ON_STARTUP=true

# --- API ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# --- Agents ------------------------------------------------------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
USE_LLM=true
INVENTORY_CLIENT=http
PAGUME_API_BASE_URL=http://127.0.0.1:8000

# --- Portals (baked in at image build time) ----------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
# runtime = npm ci inside Docker. prebuilt = use portals/dist/ from the host.
PORTALS_DOCKER_TARGET=runtime

# --- Host ports --------------------------------------------------------------
API_HOST_PORT=8000
AGENTS_HOST_PORT=8100
PORTALS_HOST_PORT=8080
DB_HOST_PORT=5433
