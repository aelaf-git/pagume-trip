# Copy to .env next to docker-compose.yml, then fill in the real values.
# docker compose reads this file automatically.

# --- Primary database (Neon) -------------------------------------------------
# The API uses this whenever it is reachable.
NEON_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/DBNAME?sslmode=require

# --- Local mirror (the postgis container) ------------------------------------
POSTGRES_USER=pagume
POSTGRES_PASSWORD=pagume
POSTGRES_DB=pagume
# Reachable from other containers as db:5432.
LOCAL_DATABASE_URL=postgresql+psycopg://pagume:pagume@db:5432/pagume

# --- Failover behaviour ------------------------------------------------------
# false pins the API to NEON_DATABASE_URL and disables the mirror fallback.
DB_FAILOVER_ENABLED=true
# Seconds before a connection attempt to the primary is treated as down.
DB_CONNECT_TIMEOUT=3
# Seconds between primary re-probes while running on the mirror.
DB_PROBE_INTERVAL=30
# Replay journalled offline writes to Neon automatically on reconnect.
DB_SYNC_AUTO_PUSH=true
SEED_ON_STARTUP=true

# --- Services ----------------------------------------------------------------
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME  (uploads need internet)
CLOUDINARY_URL=
# Groq key for the agents service. Empty + USE_LLM=false runs deterministic templates.
GROQ_API_KEY=
USE_LLM=true
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Baked into the portals bundle at build time. Use the host-reachable API URL.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Host port mappings ------------------------------------------------------
API_HOST_PORT=8000
AGENTS_HOST_PORT=8100
PORTALS_HOST_PORT=8080
# 5433 avoids clashing with a Postgres already installed on the host.
DB_HOST_PORT=5433
