# Throwaway env for the offline-failover verification run. No real credentials:
# a second database in the same postgis container stands in for Neon.
NEON_DATABASE_URL=postgresql+psycopg://pagume:pagume@db:5432/pagume_primary
LOCAL_DATABASE_URL=postgresql+psycopg://pagume:pagume@db:5432/pagume

POSTGRES_USER=pagume
POSTGRES_PASSWORD=pagume
POSTGRES_DB=pagume

DB_FAILOVER_ENABLED=true
DB_CONNECT_TIMEOUT=3
DB_PROBE_INTERVAL=5
DB_SYNC_AUTO_PUSH=false
SEED_ON_STARTUP=true

CLOUDINARY_URL=
GROQ_API_KEY=
USE_LLM=false

VITE_API_BASE_URL=http://localhost:8000/api/v1

API_HOST_PORT=8000
AGENTS_HOST_PORT=8100
PORTALS_HOST_PORT=8080
DB_HOST_PORT=5433
